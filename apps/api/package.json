{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API NestJS /api/v1 (REST + SSE + OpenAPI)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env.local --watch-path=dist --watch-path=../../packages dist/main.js",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "openapi": "node dist/openapi-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@cap/contracts": "workspace:*",
    "@cap/database": "workspace:*",
    "@cap/secrets": "workspace:*",
    "@cap/server-core": "workspace:*",
    "@cap/storage": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.0.5",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "^5.2.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "ldapts": "^9.2.0",
    "openid-client": "^6.8.9",
    "otplib": "13.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "oxlint": "1.93.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
