# Interface Angular servie par Nginx (non privilégié), reverse proxy de l'API.
ARG NODE_IMAGE=node:26-bookworm-slim
FROM ${NODE_IMAGE} AS build
ARG PNPM_VERSION=12.18.0
RUN npm install -g "pnpm@${PNPM_VERSION}" && npm cache clean --force
ENV CI=true
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter web --filter @cap/contracts
COPY apps/web ./apps/web
RUN pnpm --filter @cap/contracts build && pnpm --filter web build

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY infrastructure/docker/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist/web/browser /usr/share/nginx/html
EXPOSE 8080
