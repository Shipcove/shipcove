{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tests de bout en bout contre une pile Docker Compose r\u00e9elle (web \u2192 api \u2192 worker \u2192 sandbox Pi \u2192 gateway \u2192 LiteLLM).",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=900000 *.test.mjs",
    "test:stack": "node --test --test-concurrency=1 --test-timeout=900000 stack.test.mjs",
    "test:ui": "node --test --test-timeout=300000 ui.test.mjs",
    "test:sso": "node --test --test-concurrency=1 --test-timeout=300000 sso.test.mjs",
    "sso:up": "docker compose -f sso/compose.sso.yml up -d --wait",
    "sso:down": "docker compose -f sso/compose.sso.yml down",
    "test:git": "node --test --test-concurrency=1 --test-timeout=600000 git.test.mjs",
    "test:features": "node --test --test-concurrency=1 --test-timeout=900000 features.test.mjs",
    "forge:up": "docker compose -f forge/compose.forge.yml up -d --wait",
    "forge:down": "docker compose -f forge/compose.forge.yml down -v",
    "build": "node --check client.mjs",
    "lint": "node --check client.mjs",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "otplib": "13.6.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
