{
  "name": "@cap/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkspaceStorage : checkpoints incr\u00e9mentaux S3, manifestes versionn\u00e9s, fencing.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@cap/database": "workspace:*",
    "@cap/sandbox": "workspace:*",
    "diff": "8.0.2",
    "drizzle-orm": "0.45.4",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/tar-stream": "3.1.5",
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "@aws-sdk/client-s3": "3.1160.0",
    "@cap/server-core": "workspace:*"
  }
}
