{
  "name": "@cap/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sch\u00e9mas (Zod) et types partag\u00e9s navigateur/serveur. Aucune d\u00e9pendance Node ni framework.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "files": [
    "dist"
  ]
}
