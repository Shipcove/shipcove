# Configuration Git système de la sandbox.
# Aucun secret de forge dans la sandbox : ~/.gitconfig (écrit par la plateforme) fournit le jeton
# de run, que la gateway remplace par le jeton OAuth de l'utilisateur (ADR 0013).
[credential]
	helper =
[safe]
	directory = /workspace
[init]
	defaultBranch = main
[advice]
	detachedHead = false
[push]
	autoSetupRemote = true
[core]
	pager = cat
