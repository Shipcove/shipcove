# Copier en `.env` puis adapter. Aucun secret d'infrastructure ici : ils sont générés dans .secrets/ et
# dans Vault. Seule la configuration facultative en fin de fichier peut contenir des secrets (chmod 600).
CAP_VERSION=0.1.0
CAP_NODE_ENV=production
# URL publique de l'application et domaine (distinct) des previews.
CAP_PUBLIC_URL=http://localhost:8080
CAP_PREVIEW_DOMAIN=preview.localhost
CAP_PREVIEW_SCHEME=http
CAP_PREVIEW_PORT=8090
# Mettre à true derrière HTTPS.
CAP_COOKIE_SECURE=false
# Interfaces d'écoute (127.0.0.1 par défaut ; 0.0.0.0 derrière un reverse proxy TLS).
CAP_HTTP_BIND=127.0.0.1
CAP_HTTP_PORT=8080
CAP_PREVIEW_BIND=127.0.0.1
# Groupe propriétaire de /var/run/docker.sock sur l'hôte (stat -c %g /var/run/docker.sock).
# Seul le garde Docker (docker-guard) accède au socket ; le worker passe par lui.
CAP_DOCKER_GID=999
# Runtimes de conteneur supplémentaires autorisés pour les sandboxes (ex. runsc pour gVisor).
CAP_SANDBOX_RUNTIMES=
CAP_SANDBOX_IMAGE=shipcove-sandbox:0.1.0
# Réseau privé par sandbox : plage découpée en /28 (4 096 sandboxes pour un /16). Elle ne doit
# chevaucher aucun réseau de l'hôte ni de l'entreprise. Vide : réseau partagé (déconseillé).
CAP_SANDBOX_SUBNET_POOL=10.231.0.0/16
# Images que la garde Docker accepte de télécharger (préfixes, séparés par des virgules ; vide : toutes).
CAP_GUARD_PULL_ALLOWLIST=
# Proxys dont l'API accepte l'adresse client (X-Forwarded-For) : services, adresses ou plages.
# CAP_TRUST_PROXY=loopback, web, edge
CAP_API_REPLICAS=2
# Administrateur initial (créé uniquement si aucun administrateur n'existe). Changez le mot de passe.
CAP_ADMIN_EMAIL=admin@example.test
CAP_ADMIN_PASSWORD=

# Déverrouillage de Vault : file (développement), manual (clés réparties), auto (KMS / transit).
# Voir docs/operations/vault.md. En production : manual ou auto.
CAP_VAULT_UNSEAL_MODE=file

# Point d'entrée TLS intégré (profil « tls », Caddy) : docker compose --profile tls up -d
# Voir docs/operations/tls.md. Penser à CAP_PUBLIC_URL=https://…, CAP_PREVIEW_SCHEME=https,
# CAP_PREVIEW_PORT=443 et CAP_COOKIE_SECURE=true.
CAP_DOMAIN=
CAP_TLS_EMAIL=
# on-demand (certificat par preview) ou files (wildcard fourni dans edge/certs/)
CAP_TLS_PREVIEW=on-demand

# ---------------------------------------------------------------------------------------------
# Configuration par variables d'environnement (toutes FACULTATIVES), appliquée par l'API à chaque
# démarrage. Ce qui est déclaré ici est réappliqué au redémarrage (une modification faite depuis
# l'administration sur ces éléments est alors remplacée) ; le reste se règle dans l'administration.
# Secrets : variante <NOM>_FILE possible (chemin d'un fichier monté). Détail de chaque variable :
# docs/operations/environment.md.
# ---------------------------------------------------------------------------------------------

# --- LiteLLM et modèles ---
# Proxy LiteLLM existant (sinon : celui fourni, http://litellm:4000) et sa clé d'administration.
# CAP_LITELLM_URL=https://litellm.example.com
# LITELLM_MASTER_KEY=sk-...
# Modèles créés dans LiteLLM s'ils n'existent pas (JSON, format de /model/new). Activés d'office.
# LITELLM_MODELS='[{"model_name":"claude-sonnet","litellm_params":{"model":"anthropic/claude-sonnet-5-5","api_key":"sk-ant-..."}}]'
# Découverte des modèles au démarrage (true par défaut) et périodique (minutes, 0 = désactivée).
# LITELLM_SYNC_ON_START=true
# LITELLM_SYNC_INTERVAL_MINUTES=0
# Modèles activés après découverte (noms LiteLLM séparés par des virgules, ou * pour tous).
# LITELLM_ENABLED_MODELS=*
# LITELLM_DEFAULT_MODEL=claude-sonnet
# LITELLM_TITLE_MODEL=claude-sonnet

# --- SSO (un fournisseur par type ; SSO_PROVIDERS en JSON pour en déclarer plusieurs) ---
# SSO_OIDC_ISSUER=https://keycloak.example.com/realms/acme
# SSO_OIDC_CLIENT_ID=shipcove
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_NAME=Keycloak
# SSO_SAML_ENTRY_POINT=https://idp.example.com/sso/saml
# SSO_SAML_ISSUER=shipcove
# SSO_SAML_IDP_CERT_FILE=/run/secrets/idp.pem
# SSO_LDAP_URL=ldaps://ldap.example.com
# SSO_LDAP_BIND_DN=cn=shipcove,ou=services,dc=example,dc=com
# SSO_LDAP_BIND_PASSWORD=
# SSO_LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# SSO_GITLAB_CLIENT_ID=
# SSO_GITLAB_CLIENT_SECRET=
# SSO_GITLAB_HOST=gitlab.example.com
# SSO_GITHUB_CLIENT_ID=
# SSO_GITHUB_CLIENT_SECRET=

# --- Forges Git (application OAuth ; GIT_FORGES en JSON pour en déclarer plusieurs) ---
# GIT_GITLAB_HOST=gitlab.example.com
# GIT_GITLAB_CLIENT_ID=
# GIT_GITLAB_CLIENT_SECRET=
# GIT_GITHUB_CLIENT_ID=
# GIT_GITHUB_CLIENT_SECRET=
# GIT_ALLOW_PERSONAL_TOKENS=false
# GIT_INSECURE_HTTP_HOSTS=
# GIT_CO_AUTHOR_EMAIL=noreply@shipcove.dev

# --- SMTP ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=shipcove@example.com
# SMTP_FROM_NAME=Shipcove

# --- Connexion et paramètres plateforme ---
# AUTH_LOCAL_LOGIN_ENABLED=true
# AUTH_REGISTRATION_ENABLED=false
# AUTH_MFA_POLICY=required_admins
# Toute autre section des paramètres (JSON, fusionné aux valeurs actuelles) :
# PLATFORM_SETTINGS='{"sandbox":{"cpu":4,"memoryMb":8192},"previews":{"allowedPorts":["3000-9999"]}}'
