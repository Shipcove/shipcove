{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Interface Angular + Tailwind CSS (utilisateurs et administration)",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --proxy-config proxy.conf.json",
