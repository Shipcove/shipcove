#!/usr/bin/env node
// cap-snapshot — inventaire du système de fichiers réel de la sandbox (ADR 0006).
//
//   cap-snapshot scan <racine>... [--exclude motif]...
//
// Écrit sur stdout un JSON : { entries: [{ p, t, m, s, mt, h?, l? }], hashed, scanned, ms }
//   p : chemin absolu ; t : 'f' fichier | 'd' dossier | 'l' lien symbolique ; m : mode ;
//   s : taille ; mt : mtime (ms) ; h : sha256 (fichiers) ; l : cible (liens).
//
// Un cache local (/run/cap/statcache.json, hors snapshot) associe chaque chemin à
// (taille, mtime ns, ctime ns, inode) → sha256 : seuls les fichiers dont l'un de ces attributs
// a changé sont re-hachés. Les écritures faites par n'importe quel processus (shell, serveur de
// dev, Pi) sont donc détectées, pas seulement celles des outils write/edit.
import { createHash } from 'node:crypto';
import { createReadStream } from 'node:fs';
import { lstat, readdir, readFile, readlink, writeFile, rename } from 'node:fs/promises';
import { join } from 'node:path';

const CACHE = '/run/cap/statcache.json';
const args = process.argv.slice(2);
const cmd = args.shift();
if (cmd !== 'scan') {
  process.stderr.write('usage: cap-snapshot scan <racine>... [--exclude motif]...\n');
  process.exit(2);
}
const roots = [];
const excludes = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--exclude') excludes.push(args[++i]);
  else roots.push(args[i]);
}
const excludeRe = excludes.map((g) => new RegExp(`(^|/)${g.replace(/[.+^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '[^/]*')}(/|$)`));
const isExcluded = (p) => excludeRe.some((re) => re.test(p));

let cache = {};
try {
  cache = JSON.parse(await readFile(CACHE, 'utf8'));
} catch {
  cache = {};
}
const nextCache = {};
const entries = [];
let hashed = 0;

function sha256File(path) {
  return new Promise((resolve, reject) => {
    const h = createHash('sha256');
    createReadStream(path)
      .on('data', (c) => h.update(c))
      .on('end', () => resolve(h.digest('hex')))
      .on('error', reject);
  });
}

async function walk(dir) {
  let names;
  try {
    names = await readdir(dir);
  } catch (err) {
    if (err.code === 'ENOENT') return;
    throw err;
  }
  names.sort();
  for (const name of names) {
    const p = join(dir, name);
    if (isExcluded(p)) continue;
    let st;
    try {
      st = await lstat(p, { bigint: true });
    } catch (err) {
      if (err.code === 'ENOENT') continue; // supprimé pendant le parcours
      throw err;
    }
    const mode = Number(st.mode & 0o7777n);
    const mt = Number(st.mtimeMs);
    if (st.isDirectory()) {
      entries.push({ p, t: 'd', m: mode, s: 0, mt });
      await walk(p);
    } else if (st.isSymbolicLink()) {
      entries.push({ p, t: 'l', m: mode, s: 0, mt, l: await readlink(p) });
    } else if (st.isFile()) {
      const key = `${st.size}:${st.mtimeNs}:${st.ctimeNs}:${st.ino}`;
      let h = cache[p]?.k === key ? cache[p].h : null;
      if (!h) {
        try {
          h = await sha256File(p);
          hashed++;
        } catch (err) {
          if (err.code === 'ENOENT') continue;
          throw err;
        }
      }
      nextCache[p] = { k: key, h };
      entries.push({ p, t: 'f', m: mode, s: Number(st.size), mt, h });
    }
    // sockets, fifos, périphériques : ignorés (non restaurables).
  }
}

const t0 = Date.now();
for (const r of roots) await walk(r);
const tmp = `${CACHE}.tmp`;
try {
  await writeFile(tmp, JSON.stringify(nextCache));
  await rename(tmp, CACHE);
} catch {
  /* cache facultatif */
}
process.stdout.write(JSON.stringify({ entries, hashed, scanned: entries.length, ms: Date.now() - t0 }));
