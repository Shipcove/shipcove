{
  "name": "coding-agent-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme auto-hébergeable de coding agents (Pi + LiteLLM) pour équipes et entreprises",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cap/database generate",
    "db:migrate": "pnpm --filter @cap/database migrate",
    "dev:infra": "docker compose -f infrastructure/docker/compose.yml --profile dev up -d postgres vault garage bootstrap vault-unsealer litellm mailpit mock-llm",
    "dev:infra:down": "docker compose -f infrastructure/docker/compose.yml --profile dev down",
    "e2e": "pnpm --filter e2e test",
    "test:infra:up": "./tools/test-infra/up.sh",
    "test:infra:down": "./tools/test-infra/down.sh"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
